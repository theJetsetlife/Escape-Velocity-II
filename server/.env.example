# Copy to server/.env and edit. Also used by the top-level Makefile and tools/deploy.sh.
# PC address the PS4 can reach (the stage is built with it and reports/downloads from it)
PC_IP=192.168.1.10
PC_PORT=9031
WEB_PORT=9898
# Absolute path of a WebKitty checkout (https://github.com/ArabPixel/WebKitty, tested at ca35118).
# Only includes/payloads/HEN/goldhen_v2.4b18.14.bin is replaced by deploy; never edit WebKitty code.
WEBKITTY_DIR=/path/to/WebKitty
