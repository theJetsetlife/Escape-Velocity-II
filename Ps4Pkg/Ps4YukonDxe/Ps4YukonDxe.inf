[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Ps4YukonDxe
  FILE_GUID                      = 4F0C7A1E-6B3D-4E52-9C8A-2D7E15B6A903
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = InitializeMarvellYukonDriver

#
# The following information is for reference only and not required by the build tools.
#
#  DRIVER_BINDING                =  gMarvellYukonDriverBinding
#  COMPONENT_NAME                =  gSimpleNetworkComponentName
#  COMPONENT_NAME2               =  gSimpleNetworkComponentName2
#

[Sources]
  Snp.c
  DriverBinding.c
  ComponentName.c
  e1000phy.c
  if_msk.c

[Packages]
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  NetworkPkg/NetworkPkg.dec
  UefiPayloadPkg/UefiPayloadPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DevicePathLib
  HobLib
  IoLib
  MemoryAllocationLib
  NetLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Guids]
  gUefiAcpiBoardInfoGuid                        ## CONSUMES ## HOB (ECAM for the boot-param MAC)

[Protocols]
  gEfiDevicePathProtocolGuid
  gEfiMetronomeArchProtocolGuid
  gEfiPciIoProtocolGuid
  gEfiPxeBaseCodeProtocolGuid
  gEfiSimpleNetworkProtocolGuid

[Depex]
  TRUE
