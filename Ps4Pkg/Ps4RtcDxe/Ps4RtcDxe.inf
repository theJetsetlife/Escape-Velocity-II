## @file
#  Real Time Clock for the PS4 (no CMOS): the Aeolia/Belize battery-backed seconds counter
#  (00:14.4 BAR2 + 0x130) as EFI runtime time, shared with the ACPI TAD through a mailbox.
#  TSC fallback when no glue function answers (QEMU harness).
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Ps4RtcDxe
  FILE_GUID                      = 318320D3-3F46-4600-BB3D-4132FC2C33D9
  MODULE_TYPE                    = DXE_RUNTIME_DRIVER
  VERSION_STRING                 = 2.0
  ENTRY_POINT                    = Ps4RtcEntryPoint

[Sources]
  Ps4RtcDxe.c

[Packages]
  MdePkg/MdePkg.dec
  UefiPayloadPkg/UefiPayloadPkg.dec
  Ps4Pkg/Ps4Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DxeServicesTableLib
  HobLib
  IoLib
  PcdLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiRuntimeServicesTableLib

[Guids]
  gPs4DirectbootInfoGuid                        ## SOMETIMES_CONSUMES ## HOB
  gUefiAcpiBoardInfoGuid                        ## SOMETIMES_CONSUMES ## HOB (ECAM)
  gPs4RtcMailboxGuid                            ## PRODUCES ## SystemTable
  gEfiEventVirtualAddressChangeGuid             ## CONSUMES ## Event

[Protocols]
  gEfiRealTimeClockArchProtocolGuid             ## PRODUCES

[Pcd]
  gPs4TokenSpaceGuid.PcdPs4RtcFallbackUnixTime  ## CONSUMES

[Depex]
  gEfiCpuArchProtocolGuid                       # UC + RUNTIME attributes on the counter page
